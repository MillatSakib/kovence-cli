{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "types": ["node"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/config/**/*.js", "src/settings/**/*.js", "src/cli/args.js", "scripts/**/*.js"],
    "exclude": ["node_modules", ".kovence", ".ai_harness", "coverage"]
}
