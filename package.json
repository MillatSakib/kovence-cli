{
    "name": "kovence-cli",
    "version": "1.0.1",
    "description": "Kovence CLI — Fast zero-dependency multi-step AI coding-agent CLI harness",
    "license": "MIT",
    "homepage": "https://github.com/MillatSakib/kovence-cli#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MillatSakib/kovence-cli.git"
    },
    "bugs": {
        "url": "https://github.com/MillatSakib/kovence-cli/issues"
    },
    "keywords": [
        "cli",
        "ai",
        "coding-agent",
        "llm",
        "tui",
        "openai",
        "anthropic",
        "kovence"
    ],
    "main": "nd.js",
    "engines": {
        "node": ">=20.12.0"
    },
    "bin": {
        "kovence-cli": "nd.js",
        "kovence": "nd.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "check": "node scripts/check.js",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit --allowJs --checkJs",
        "prepublishOnly": "npm run check && npm run lint && npm run typecheck && npm run format:check && npm test"
    },
    "files": [
        "nd.js",
        "store.js",
        "ui.js",
        "tools.js",
        "providers.js",
        "tui.js",
        "src/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "SECURITY.md"
    ],
    "devDependencies": {
        "@types/node": "^26.6.6",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2"
    }
}
