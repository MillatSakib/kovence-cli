{
    "name": "kovence-cli",
    "version": "1.0.0",
    "description": "Kovence CLI — Fast zero-dependency multi-step AI coding-agent CLI harness",
    "license": "MIT",
    "engines": {
        "node": ">=20.12.0"
    },
    "bin": {
        "kovence-cli": "./nd.js",
        "kovence": "./nd.js"
    },
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "check": "node scripts/check.js",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit --allowJs --checkJs"
    },
    "files": [
        "nd.js",
        "store.js",
        "ui.js",
        "tools.js",
        "providers.js",
        "tui.js",
        "src/",
        "README.md",
        "CHANGELOG.md"
    ],
    "devDependencies": {
        "@types/node": "^26.6.6",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2"
    }
}
